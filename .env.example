# UE Cloudlearn — Environment Variable Template (Sanitized)
# Copy this file to `.env` for local development and replace placeholder values.
# NEVER commit `.env`, private keys, passwords, JWT secrets, or AWS credentials to Git.

NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
JWT_SECRET=replace-with-strong-64-char-random-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ue_cloudlearn
DB_USER=ue_cloudlearn_app
DB_PASSWORD=replace-with-strong-db-password

AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=ue-cloudlearn-files-replace-me
STORAGE_MODE=s3
# Note: On EC2, AWS credentials come automatically from the attached IAM Instance Role.
# For local development only, AWS CLI profile (~/.aws/credentials) is used automatically.
# NEVER put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY into committed files.
